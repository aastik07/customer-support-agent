# ──────────────────────────────────────────────
# Microsoft Foundry / Azure Configuration
# ──────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_FOUNDRY_PROJECT_NAME=your-project-name
AZURE_FOUNDRY_ENDPOINT=https://your-endpoint.api.azureml.ms

# ──────────────────────────────────────────────
# Microsoft Foundry Agent
# ──────────────────────────────────────────────
AGENT_ID=your-agent-id
AGENT_MODEL=gpt-4o

# ──────────────────────────────────────────────
# Foundry IQ / RAG
# ──────────────────────────────────────────────
SEARCH_INDEX_NAME=your-search-index
SEARCH_ENDPOINT=https://your-search.search.windows.net
SEARCH_API_KEY=your-search-api-key

# ──────────────────────────────────────────────
# FastAPI Backend
# ──────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# ──────────────────────────────────────────────
# Custom Tool API Authentication
# ──────────────────────────────────────────────
# Protects the four custom-tool endpoints exposed to Microsoft Foundry:
#   GET  /orders/{order_id}
#   GET  /customers/{customer_id}
#   GET  /refunds/{order_id}
#   POST /tickets
#
# Callers (including Foundry) must send this value in the x-api-key header.
# Choose any strong random string — do NOT use the placeholder below in production.
# Never commit the real value to Git.
CUSTOMER_SUPPORT_API_KEY=replace-with-your-local-api-key
